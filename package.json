{
  "name": "nodejs_express_mysql",
  "version": "0.9.0",
  "description": "nodeJS + express + mysql | REST API (NodeJS)",
  "main": "server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "seed": "npx sequelize-cli db:seed:all",
    "start": "nodemon server.js",
    "lint": "eslint ./app",
    "lint-fix": "eslint ./app --fix",
    "new-module": "node ./scripts/hexagonal/create-module.js",
    "update-system-data": "npx sequelize-cli db:seed --seed '00000000000001-insert-system-managed-data.js'"
  },
  "author": "Farena",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.1",
    "compression": "^1.7.4",
    "dotenv": "^8.2.0",
    "excel4node": "^1.8.0",
    "express": "^4.18.2",
    "fs": "0.0.1-security",
    "fs-extra": "^9.0.1",
    "handlebars": "^4.7.7",
    "helmet": "^4.1.1",
    "https": "^1.0.0",
    "jsonwebtoken": "^9.0.3",
    "mime-types": "^2.1.30",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "mysql2": "^3.17.0",
    "nodemailer": "^8.0.1",
    "nodemon": "^3.1.11",
    "puppeteer": "^24.15.0",
    "sequelize": "^6.37.7",
    "uuid": "^9.0.1",
    "validatorjs": "^3.22.1",
    "yargs": "^17.6.2",
    "yargs-interactive": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.4",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.15.0",
    "@jest/globals": "^30.2.0",
    "eslint": "^9.15.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^28.8.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^30.2.0",
    "prettier": "^3.4.0",
    "sequelize-cli": "^6.6.5"
